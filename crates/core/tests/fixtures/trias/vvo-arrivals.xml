y><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;h2&gt;&lt;strong&gt;Haltestellenverlegung Chemnitzer Straße in stadtauswärtiger Richtung&lt;/strong&gt;&lt;/h2&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;div style="color:rgb(0, 0, 0);font-family:&amp;quot;Open Sans&amp;quot;;font-size:10pt;line-height:15pt;margin:0cm;"&gt;Die Haltestelle „Dresden, Chemnitzer Straße“ in stadtauswärtiger Fahrtrichtung wird ab dem 14.09.2026 bis auf Widerruf um etwa 50 Meter vor den bisherigen Standort verlegt.&lt;/div&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt; inEFA="false";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2025-08-29T14:16:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>23971</siri:SituationNumber><siri:Version>273255361</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2025-08-27T22:00:00Z</siri:StartTime><siri:EndTime>2500-12-30T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Haltestellenverlegung Haltestelle Dresden, Wölfnitzer Ring</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;h2&gt;&lt;strong&gt;Haltestellenverlegung Haltestelle Dresden, Wölfnitzer Ring&lt;/strong&gt;&lt;/h2&gt;&lt;div style="color:rgb(0, 0, 0);font-family:&amp;quot;Open Sans&amp;quot;;font-size:10pt;margin:0cm;"&gt;Die Haltestelle Dresden, Wölfnitzer Ring wird im genannten Zeitraum um etwa 20 Meter vor die ursprüngliche Position verlegt – direkt vor Hausnummer 139.&lt;/div&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt; inEFA="false";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-11-23T16:26:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>28193</siri:SituationNumber><siri:Version>312225961</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-11-23T06:00:00Z</siri:StartTime><siri:EndTime>2026-12-04T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Vollsperrung Hühndorfer Höhe in Wilsdruff</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;h2&gt;&lt;strong&gt;Vollsperrung Hühndorfer Höhe in Wilsdruff&lt;/strong&gt;&lt;/h2&gt;&lt;div style="color:rgb(0, 0, 0);font-family:;"&gt;&amp;nbsp;&lt;/div&gt;&lt;div style="color:rgb(0, 0, 0);font-family:;"&gt;Die Haltestellen Wilsdruff, Abzw. Sachsdorf und Hühndorfer Höhe West sowie Hühndorfer Höhe Ost können aufgrund einer Vollsperrung der Hühndorfer Höhe in Wilsdruff nicht bedient werden.&lt;/div&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt; inEFA="false";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2025-09-25T13:31:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>24199</siri:SituationNumber><siri:Version>275585462</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2025-09-25T22:00:00Z</siri:StartTime><siri:EndTime>2500-12-30T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Haltestellenverlegung Haltestelle Dresden, Hirtenstraße</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;h2&gt;&lt;strong&gt;Haltestellenverlegung Haltestelle Dresden, Hirtenstraße&amp;nbsp;&lt;/strong&gt;&lt;/h2&gt;&lt;p&gt;Die Haltestelle&amp;nbsp;Dresden, Hirtenstraße&amp;nbsp;in Fahrtrichtung&amp;nbsp;Kesselsdorf&amp;nbsp;wird im oben genannten Zeitraum&amp;nbsp;um etwa 65 Meter in Fahrtrichtung vorverlegt.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt; inEFA="false";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:23333: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-11-13T16:06:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>28105</siri:SituationNumber><siri:Version>311360761</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-11-23T07:30:00Z</siri:StartTime><siri:EndTime>2026-11-25T18:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Dresden - Vorwerkstraße, Gleisbau</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;div style="display:none;"&gt;&amp;nbsp;&lt;/div&gt;&lt;h2&gt;Änderungen im Linienverkehr&amp;nbsp;&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Straßenbahnlinie 10: &lt;/strong&gt;&lt;span style="color:rgb(255,0,0);"&gt;verkürzte Linienführung&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;br&gt;Striesen – Straßburger Platz – Hauptbahnhof – &lt;span style="color:rgb(0,0,0);"&gt;&lt;u&gt;Bahnhof Mitte&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2&gt;Ersatzverkehr&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Ersatzbusverkehr EV 10: &lt;/strong&gt;&lt;span style="color:rgb(255,0,0);"&gt;Ersatz für die Linie 10 &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;br&gt;&lt;span style="color:rgb(0,0,0);"&gt;&lt;u&gt;Bahnhof Mitte&lt;/u&gt;&lt;/span&gt; – Weißeritzstraße – Krankenhaus Friedrichstadt&lt;span style="color:rgb(0,0,0);"&gt; – MESSE DRESDEN&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Der Umstieg von der Linie 10 zum Ersatzverkehr &lt;span style="color:hsl(0,100%,50%);"&gt;in Richtung MESSE DRESDEN&lt;/span&gt; erfolgt an der Haltestelle &lt;strong&gt;Bahnhof Mitte &lt;/strong&gt;(Zentralhaltestelle, Steig 2).&lt;/li&gt;&lt;li&gt;Der Umstieg vom Ersatzverkehr zur Linie 10 &lt;span style="color:hsl(0,100%,50%);"&gt;in Richtung Striesen&lt;/span&gt; erfolgt an der Haltestelle &lt;strong&gt;Bahnhof Mitte &lt;/strong&gt;(Könneritzstraße, Steig 3).&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Haltestellenanpassungen / Hinweise&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Messe, Gleisschleife&lt;/strong&gt; kann nicht bedient werden.&lt;/li&gt;&lt;li&gt;Abfahrten ab der Haltestelle &lt;strong&gt;MESSE DRESDEN&lt;/strong&gt; &lt;span style="color:hsl(0,100%,50%);"&gt;in Richtung Bahnhof Mitte &lt;/span&gt;&lt;span style="color:hsl(0,0%,0%);"&gt;erfolgen an der Ersatzhaltestelle auf der Straße “Zur Messe”.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt; inEFA="false";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:11010: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11010: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21110: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21110: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-10-28T16:31:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>27796</siri:SituationNumber><siri:Version>309979863</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-10-12T01:00:00Z</siri:StartTime><siri:EndTime>2500-12-30T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Dresden - Endpunkt-Verlegung (Südvorstadt) wegen Bau Campuslinie</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;div style="display:none;"&gt;&amp;nbsp;&lt;/div&gt;&lt;h2&gt;Änderungen im Linienverkehr&lt;/h2&gt;&lt;p&gt;Aufgrund der Baumaßnahmen für die „Campuslinie“ kann die Linie 8 die bisherige Endhaltestelle Südvorstadt nicht mehr bedienen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Sie fährt ab Nürnberger Platz über Münchner Platz bis zur neuen Endhaltestelle &lt;strong&gt;Plauen, Nöthnitzer Straße&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Straßenbahnlinie 8: &lt;/strong&gt;&lt;span style="color:rgb(255,0,0);"&gt;veränderte Linienführung&lt;/span&gt;&lt;span style="color:rgb(0,0,0);"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;&amp;nbsp;&lt;br&gt;&lt;span style="color:rgb(0,0,0);"&gt;Hellerau – Albertplatz – Nürnberger Platz – &lt;/span&gt;&lt;u&gt;Plauen, Nöthnitzer Straße&lt;/u&gt;&lt;/p&gt;&lt;h2&gt;Haltestellenanpassungen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Südvorstadt &lt;/strong&gt;kann durch die Linie 8 &lt;u&gt;nicht mehr&lt;/u&gt; bedient werden.&lt;/li&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Nürnberger Platz&lt;/strong&gt; wird in beiden Richtungen an der Haltestelle der Linie 3 bedient.&lt;/li&gt;&lt;li&gt;Die Haltestellen &lt;strong&gt;Münchner Platz &lt;/strong&gt;und &lt;strong&gt;Plauen Nöthnitzer Straße &lt;/strong&gt;werden durch die Linie 8 zusätzlich bedient.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Weiterführende Informationen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href="https://www.dvb.de/ext/pdf/Bau_Campuslinie_Li8_121026.pdf"&gt;Infoflyer zur Baumaßnahme&amp;nbsp;&lt;/a&gt; (PDF&amp;nbsp;|&amp;nbsp;425&amp;nbsp;KB)&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-09-28T11:31:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>27519</siri:SituationNumber><siri:Version>307373462</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-09-28T20:00:00Z</siri:StartTime><siri:EndTime>2500-12-30T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Dresden - Königsbrücker Straße (1. Bauphase), Gleis- / Straßenbau</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;div style="display:none;"&gt;&amp;nbsp;&lt;/div&gt;&lt;p&gt;Ab dem &lt;strong&gt;28. September 2026&lt;/strong&gt; beginnen die Arbeiten zum umfassenden Ausbau der Königsbrücker Straße. Die Baumaßnahme gehört zu den größten Infrastrukturprojekten in der Stadt Dresden und schafft die Voraussetzungen für einen modernen, leistungs- fähigen und barrierefreien öffentlichen Nahverkehr. Der Ausbau erfolgt in mehreren Bauabschnitten.&lt;/p&gt;&lt;h2&gt;Änderungen im Linienverkehr&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Straßenbahnlinien 7 und 8:&lt;/strong&gt;&lt;br&gt;Umleitung zwischen den Haltestellen Albertplatz und Bischofsweg über die Haltestellen &lt;u&gt;Bahnhof Neustadt – Großenhainer Platz – Friedensstraße - S-Bf. Bischofsplatz.&lt;/u&gt;&lt;/p&gt;&lt;h2&gt;Haltestellenanpassungen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Louisenstraße &lt;/strong&gt;kann &lt;u&gt;nicht bedient werden&lt;/u&gt;.&lt;/li&gt;&lt;li&gt;Die Bedarfshaltestelle &lt;strong&gt;Großenhainer Straße / Fritz-Reuter-Straße&lt;/strong&gt; wird in beiden Richtungen &lt;u&gt;nicht bedient&lt;/u&gt;.&lt;/li&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Bahnhof Neustadt&lt;/strong&gt;, &lt;strong&gt;Bahnhof Neustadt (Hansastraße)&lt;/strong&gt;, &lt;strong&gt;Lößnitzstraße&lt;/strong&gt;, &lt;strong&gt;Großenhainer Platz&lt;/strong&gt;,&lt;strong&gt; Friedensstraße&lt;/strong&gt; und &lt;strong&gt;S-Bahnhof Bischofsplatz&lt;/strong&gt; werden in beiden Richtungen &lt;u&gt;zusätzlich bedient&lt;/u&gt;.&lt;/li&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Bischofsweg &lt;/strong&gt;wird ersatzweise &lt;span style="color:hsl(0,100%,50%);"&gt;in Richtung Weixdorf / Hellerau&lt;/span&gt; auf dem Bischofsweg an der Haltestelle der Linie 13 (&lt;i&gt;Steig 2, in Richtung Prohlis&lt;/i&gt;) bedient.&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Weiterführende Informationen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href="https://www.dvb.de/ext/pdf/Bau_Koenigsbr_Ph1_280926_web.pdf"&gt;Infoflyer zur Baumaßnahme mit Karte der Umleitungsstrecken&lt;/a&gt; (PDF&amp;nbsp;|&amp;nbsp;977 KB)&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:11007: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11007: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation></trias:Situations></trias:StopEventResponseContext><trias:StopEventResult><trias:ResultId>ID-C82DC2E2-754B-4F97-99C4-AF7942F010C1</trias:ResultId><trias:StopEvent><trias:ThisCall><trias:CallAtStop><trias:StopPointRef>de:14612:28:2:4</trias:StopPointRef><trias:StopPointName><trias:Text>Dresden Hauptbahnhof</trias:Text><trias:Language>de</trias:Language></trias:StopPointName><trias:PlannedBay><trias:Text>4</trias:Text><trias:Language>de</trias:Language></trias:PlannedBay><trias:ServiceArrival><trias:TimetabledTime>2026-11-23T18:10:00Z</trias:TimetabledTime><trias:EstimatedTime>2026-11-23T18:13:12Z</trias:EstimatedTime></trias:ServiceArrival><trias:StopSeqNumber>19</trias:StopSeqNumber></trias:CallAtStop></trias:ThisCall><trias:Service><trias:OperatingDayRef>2026