ituationNumber>27519</siri:SituationNumber><siri:Version>307373462</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-09-28T20:00:00Z</siri:StartTime><siri:EndTime>2500-12-30T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Dresden - Königsbrücker Straße (1. Bauphase), Gleis- / Straßenbau</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;div style="display:none;"&gt;&amp;nbsp;&lt;/div&gt;&lt;p&gt;Ab dem &lt;strong&gt;28. September 2026&lt;/strong&gt; beginnen die Arbeiten zum umfassenden Ausbau der Königsbrücker Straße. Die Baumaßnahme gehört zu den größten Infrastrukturprojekten in der Stadt Dresden und schafft die Voraussetzungen für einen modernen, leistungs- fähigen und barrierefreien öffentlichen Nahverkehr. Der Ausbau erfolgt in mehreren Bauabschnitten.&lt;/p&gt;&lt;h2&gt;Änderungen im Linienverkehr&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Straßenbahnlinien 7 und 8:&lt;/strong&gt;&lt;br&gt;Umleitung zwischen den Haltestellen Albertplatz und Bischofsweg über die Haltestellen &lt;u&gt;Bahnhof Neustadt – Großenhainer Platz – Friedensstraße - S-Bf. Bischofsplatz.&lt;/u&gt;&lt;/p&gt;&lt;h2&gt;Haltestellenanpassungen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Louisenstraße &lt;/strong&gt;kann &lt;u&gt;nicht bedient werden&lt;/u&gt;.&lt;/li&gt;&lt;li&gt;Die Bedarfshaltestelle &lt;strong&gt;Großenhainer Straße / Fritz-Reuter-Straße&lt;/strong&gt; wird in beiden Richtungen &lt;u&gt;nicht bedient&lt;/u&gt;.&lt;/li&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Bahnhof Neustadt&lt;/strong&gt;, &lt;strong&gt;Bahnhof Neustadt (Hansastraße)&lt;/strong&gt;, &lt;strong&gt;Lößnitzstraße&lt;/strong&gt;, &lt;strong&gt;Großenhainer Platz&lt;/strong&gt;,&lt;strong&gt; Friedensstraße&lt;/strong&gt; und &lt;strong&gt;S-Bahnhof Bischofsplatz&lt;/strong&gt; werden in beiden Richtungen &lt;u&gt;zusätzlich bedient&lt;/u&gt;.&lt;/li&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Bischofsweg &lt;/strong&gt;wird ersatzweise &lt;span style="color:hsl(0,100%,50%);"&gt;in Richtung Weixdorf / Hellerau&lt;/span&gt; auf dem Bischofsweg an der Haltestelle der Linie 13 (&lt;i&gt;Steig 2, in Richtung Prohlis&lt;/i&gt;) bedient.&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Weiterführende Informationen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href="https://www.dvb.de/ext/pdf/Bau_Koenigsbr_Ph1_280926_web.pdf"&gt;Infoflyer zur Baumaßnahme mit Karte der Umleitungsstrecken&lt;/a&gt; (PDF&amp;nbsp;|&amp;nbsp;977 KB)&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:11007: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11007: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-10-28T16:31:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>27796</siri:SituationNumber><siri:Version>309979863</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-10-12T01:00:00Z</siri:StartTime><siri:EndTime>2500-12-30T23:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Dresden - Endpunkt-Verlegung (Südvorstadt) wegen Bau Campuslinie</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;div style="display:none;"&gt;&amp;nbsp;&lt;/div&gt;&lt;h2&gt;Änderungen im Linienverkehr&lt;/h2&gt;&lt;p&gt;Aufgrund der Baumaßnahmen für die „Campuslinie“ kann die Linie 8 die bisherige Endhaltestelle Südvorstadt nicht mehr bedienen.&amp;nbsp;&lt;/p&gt;&lt;p&gt;Sie fährt ab Nürnberger Platz über Münchner Platz bis zur neuen Endhaltestelle &lt;strong&gt;Plauen, Nöthnitzer Straße&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Straßenbahnlinie 8: &lt;/strong&gt;&lt;span style="color:rgb(255,0,0);"&gt;veränderte Linienführung&lt;/span&gt;&lt;span style="color:rgb(0,0,0);"&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;&amp;nbsp;&lt;br&gt;&lt;span style="color:rgb(0,0,0);"&gt;Hellerau – Albertplatz – Nürnberger Platz – &lt;/span&gt;&lt;u&gt;Plauen, Nöthnitzer Straße&lt;/u&gt;&lt;/p&gt;&lt;h2&gt;Haltestellenanpassungen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Südvorstadt &lt;/strong&gt;kann durch die Linie 8 &lt;u&gt;nicht mehr&lt;/u&gt; bedient werden.&lt;/li&gt;&lt;li&gt;Die Haltestelle &lt;strong&gt;Nürnberger Platz&lt;/strong&gt; wird in beiden Richtungen an der Haltestelle der Linie 3 bedient.&lt;/li&gt;&lt;li&gt;Die Haltestellen &lt;strong&gt;Münchner Platz &lt;/strong&gt;und &lt;strong&gt;Plauen Nöthnitzer Straße &lt;/strong&gt;werden durch die Linie 8 zusätzlich bedient.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Weiterführende Informationen&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href="https://www.dvb.de/ext/pdf/Bau_Campuslinie_Li8_121026.pdf"&gt;Infoflyer zur Baumaßnahme&amp;nbsp;&lt;/a&gt; (PDF&amp;nbsp;|&amp;nbsp;425&amp;nbsp;KB)&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:11008: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:21508: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-07-09T12:46:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>27001</siri:SituationNumber><siri:Version>300379562</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-07-13T04:30:00Z</siri:StartTime><siri:EndTime>2026-12-12T19:00:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Fahrzeitänderungen zwischen Dresden-Neustadt→ Görlitz</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;h2&gt;Beschreibung&lt;/h2&gt;&lt;p&gt;Aufgrund von Bauarbeiten verkehren ab dem 13.07.2026 montags bis freitags einige Züge zwischen Dresden-Neustadt und Görlitz mit geänderten Fahrzeiten und Halten.&lt;br&gt;&lt;br&gt;Bitte beachten Sie die Änderungen bei Ihrer Reiseplanung. Planen Sie mehr Zeit ein und nutzen Sie bei Bedarf frühere Verbindungen, um Anschlüsse zu erreichen.&lt;br&gt;&lt;br&gt;Weitere Details finden Sie in den Fahrplantabellen.&lt;br&gt;Wir bitten um Verständnis für die entstehenden Unannehmlichkeiten.&lt;/p&gt;&lt;h2&gt;Zusatzinformation&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;Bauarbeiten im Bahnhof Görlitz&lt;/strong&gt;&lt;br&gt;Im Juli beginnen umfangreiche Bauarbeiten im Bahnhof Görlitz. Dadurch stehen vorübergehend nur drei der vier Bahnsteige zur Verfügung, was zu Einschränkungen im Zugverkehr führt.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;13.07.2026 bis voraussichtlich Fahrplanwechsel: Die planmäßigen Halte der RB60V-Züge in Reichenbach entfallen. Als Ersatz hält der RE1 zusätzlich in Reichenbach, sodass weiterhin eine Anbindung besteht.&lt;/li&gt;&lt;li&gt;September 2026 bis Dezember 2027: Am Bahnhof Görlitz ist nur der Ausgang auf der stadtabgewandten Seite nutzbar. Für die Verbindung in die Innenstadt verkehrt ein Shuttlebus im 10-Minuten-Takt. Das Kundencenter sowie die Geschäfte im Bahnhof bleiben während der gesamten Bauzeit geöffnet und sind weiterhin über den Eingang der Haupthalle erreichbar.&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Links&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;a href="https://www.laenderbahn.com/media/laenderbahn/downloads/reiseinformationen/verkehrsmeldungen/trilex/2026/FGI_42475.pdf"&gt;Ersatzfahrplan_trilex_2026-26&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:02060::H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:02060::R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>ddb:90D60: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>ddb:90D60: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:02001::H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:02001::R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>ddb:90D01: :H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>ddb:90D01: :R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></tr