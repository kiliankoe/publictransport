ebischtal um 21.47 Uhr&amp;nbsp;&lt;br&gt;- S 31778 ab Bad Schandau um 23.14 Uhr&amp;nbsp;&lt;/li&gt;&lt;li&gt;Ersatzverkehr mit Bus&lt;/li&gt;&lt;/ul&gt;&lt;h4&gt;&lt;strong&gt;&lt;u&gt;gültig am 16. und 23. November 2026, in der Zeit zwischen 9.10 Uhr bis 18.50 Uhr&lt;/u&gt;&lt;/strong&gt;&lt;/h4&gt;&lt;ul&gt;&lt;li&gt;Die S-Bahnen verkehren zwischen Bad Schandau / Kurort Rathen ► Pirna jeweils um ca. 8 Minuten früher, ab Pirna planmäßige Weiterfahrt&amp;nbsp;&lt;/li&gt;&lt;li&gt;Fahrplanänderungen sind in der digitalten Reiseauskunft verfügbar&amp;nbsp;&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:10001::H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:10001::R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:10001:D:H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>voe:10001:D:R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>ddb:920S1:F:H:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney><siri:AffectedVehicleJourney><siri:LineRef>ddb:920S1:F:R:</siri:LineRef><siri:Route></siri:Route></siri:AffectedVehicleJourney></siri:VehicleJourneys></siri:Affects></trias:PtSituation><trias:PtSituation><siri:CreationTime>2026-11-05T15:01:00Z</siri:CreationTime><siri:ParticipantRef/><siri:SituationNumber>27784</siri:SituationNumber><siri:Version>310665662</siri:Version><siri:Source><siri:SourceType>other</siri:SourceType></siri:Source><siri:ValidityPeriod><siri:StartTime>2026-11-03T06:30:00Z</siri:StartTime><siri:EndTime>2026-12-01T16:30:00Z</siri:EndTime></siri:ValidityPeriod><siri:UnknownReason>unknown</siri:UnknownReason><siri:Priority>3</siri:Priority><siri:ScopeType>line</siri:ScopeType><siri:Summary>Brückenarbeiten im Bereich Schöna – Bad Schandau</siri:Summary><siri:Description>Linienaenderung</siri:Description><siri:Detail>&lt;h2&gt;Beschreibung&lt;/h2&gt;&lt;p&gt;Sehr geehrte Damen und Herren,&lt;/p&gt;&lt;p&gt;wegen Brückenarbeiten im Bereich Schöna – Bad Schandau kommt es &lt;strong&gt;vom 3. bis 12. November sowie am 1. Dezember 2026&lt;/strong&gt; zu folgenden Fahrplanänderungen:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;u&gt;Linie S 1 (Meißen Triebischtal – Coswig – Dresden – Pirna – Schöna)&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;gültig vom 3. bis 5. November, jeweils in der Zeit von 07.30 Uhr bis 19.45 Uhr sowie am 6. und 10. bis 13. November und dem 1. Dezember, jeweils in der Zeit von 07.30 Uhr bis 17.30 Uhr&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Ausfall aller Züge Bad Schandau&amp;nbsp;&lt;i&gt;◄►&amp;nbsp;&lt;/i&gt;Schöna; Ersatzverkehr mit Bus Bad Schandau&amp;nbsp;&lt;i&gt;◄►&lt;/i&gt;Schmilka Grenzübergang&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;strong&gt;&lt;u&gt;Linie U 28 Rumburk - Sebnitz - Bad Schandau -&amp;nbsp;&lt;/u&gt;&lt;/strong&gt;&lt;i&gt;&lt;strong&gt;&lt;u&gt; &lt;/u&gt;&lt;/strong&gt;&lt;/i&gt;&lt;strong&gt;&lt;u&gt;Decin hl.n.&lt;/u&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;gültig vom 3. bis 5., 6. und 10. bis 13. November sowie dem 1. Dezember, jeweils in der Zeit von 10.30 Uhr bis 17.30 Uhr&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Ausfall Bad Schandau&amp;nbsp;&lt;i&gt;◄►&amp;nbsp;&lt;/i&gt;Schöna; Ersatzverkehr&amp;nbsp;mit Bus; Bad Schandau&amp;nbsp;◄&lt;i&gt;►&amp;nbsp;&lt;/i&gt;Decin hl.n.&lt;/li&gt;&lt;/ul&gt;&lt;h2&gt;Links&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;Den Weg zum Ersatzverkehr mit Bus finden Sie hier &lt;a href="https://www.vvo-online.de/Umgebungsplan"&gt;https://www.vvo-online.de/Umgebungsplan&lt;/a&gt;&lt;/li&gt;&lt;/ul&gt; inEFA="true";MeldungTyp="Information"</siri:Detail><siri:Affects><siri:VehicleJourneys><siri:AffectedVehicleJourney><siri:LineRef>voe:10001::H:</siri:LineRef><siri:Route></siri:Route></siri: